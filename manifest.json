{
  "manifest_version": 3,
  "name": "Img To color",
  "version": "1.0.0",
  "description": "右键网页图片，即可帮助你获取该图片的配色信息推荐",
  "icons": {
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "permissions": ["contextMenus", "scripting", "activeTab"],
  "host_permissions": ["<all_urls>"],
  "background": {
    "service_worker": "background.js"
  },
  "web_accessible_resources": [
    {
      "resources": [
        "modal.html",
        "modal.css",
        "colorCircleSelector.js",
        "modalInteraction.js",
        "html2canvas.min.js",
        "popup.html",
        "popup.css"
      ],
      "matches": ["<all_urls>"]
    }
  ],
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["html2canvas.min.js", "content.js"],
      "run_at": "document_end"
    }
  ]
}
